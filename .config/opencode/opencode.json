    "sheep-review": { "model": "openai/gpt-5.6-luna-fast", "variant": "max", "temperature": 0.0, "steps": 80 },
    "sheep-search": { "model": "openai/gpt-5.6-luna-fast", "variant": "low", "temperature": 0.0, "steps": 50 },
